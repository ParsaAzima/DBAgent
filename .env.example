# ── AI providers ──────────────────────────────────────────────
# Fill only what you use. Any one provider is enough to start.

# OpenAI or any OpenAI-compatible gateway (Together, LM Studio, ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# OpenRouter (one key, hundreds of models). Models are "vendor/model",
# e.g. openai/gpt-4o-mini, anthropic/claude-sonnet-4, meta-llama/llama-3.1-70b-instruct
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api
# OPENROUTER_SITE_URL=https://yourapp.example.com   # optional attribution
# OPENROUTER_APP_NAME=YourApp                        # optional attribution

# Anthropic (Claude)
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=            # optional proxy

# Google Gemini
GEMINI_API_KEY=

# Ollama (local models, no key needed)
OLLAMA_BASE_URL=http://localhost:11434

# ── System mode ───────────────────────────────────────────────
# Enables system tools: db_stats, system_info, export_data, import_csv,
# backup, discover_local_databases. import_csv also needs write mode.
# DBAGENT_ALLOW_SYSTEM=1
# Output directory for exports/backups (default: ./dbagent-out)
# DBAGENT_OUT_DIR=
# Allow file paths outside the working directory (DANGEROUS)
# DBAGENT_ANY_PATH=0

# ── File & shell tools ────────────────────────────────────────
# With --allow-system the agent also gets file tools (read_file, write_file,
# edit_file, list_dir, glob_files, grep_files, delete_file).
# The bash tool is DANGEROUS and has its own separate gate:
# DBAGENT_ALLOW_SHELL=1
